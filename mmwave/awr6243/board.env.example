# ╔══════════════════════════════════════════════════════════════════════╗
# ║  AWR6243 / IWR6243 carrier description                              ║
# ║                                                                      ║
# ║  Sourced by:  mmwave/awr6243/radar-ctl.sh                           ║
# ║               mmwave/setup-awr6243.sh                                ║
# ║                                                                      ║
# ║  Copy to board.env and fill in for YOUR carrier:                    ║
# ║    cp mmwave/awr6243/board.env.example mmwave/awr6243/board.env      ║
# ║                                                                      ║
# ║  Signal names in the comments are IWR6243 device pins from the       ║
# ║  datasheet (SWRS283A) signal table. The numbers below are *host*     ║
# ║  SPI buses and GPIO line offsets — they are board specific, there    ║
# ║  is no standard pinout for this part.                                ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ─── Host SPI master ─────────────────────────────────────────────────
# The radar is always the SPI peripheral/target; the host is the master.
# On a Jetson 40-pin header, enable "spi1" in jetson-io first (see README).
AWR6243_SPIDEV="/dev/spidev0.0"
AWR6243_SPI_SPEED_HZ="5000000"
AWR6243_SPI_MODE="0"
AWR6243_SPI_BITS_PER_WORD="16"     # mmWaveLink uses 16-bit SPI words

# ─── Host GPIO lines (libgpiod) ──────────────────────────────────────
# Find the chip and line offsets with:  gpiodetect ; gpioinfo
AWR6243_GPIOCHIP="gpiochip0"

AWR6243_LINE_NRESET=""             # ->  NRESET (P12), active low, hold >=20us
AWR6243_LINE_SOP0=""               # ->  SOP0 (J13)
AWR6243_LINE_SOP1=""               # ->  SOP1 (P11)
AWR6243_LINE_SOP2=""               # ->  SOP2 (P13)
AWR6243_LINE_HOST_INTR=""          # <-  SPI_HOST_INTR_1 (P6), async events
AWR6243_LINE_NERROR=""             # <-  NERROR_OUT (N8), open drain, fault
AWR6243_LINE_PWR_EN=""             # ->  optional board/PMIC power enable
AWR6243_LINE_SYNC_IN=""            # ->  optional SYNC_IN (N10) frame trigger

# How long to hold NRESET low, and how long to wait after release, in seconds.
# Datasheet minimum is 20 us; 5 ms is a safe margin from a shell script.
AWR6243_RESET_HOLD_S="0.005"
AWR6243_RESET_SETTLE_S="0.100"

# ─── Device firmware (MMWAVE-DFP-2G-60GHZ-FW) ────────────────────────
# The xWR6243 has no user flash in production: the host downloads the
# firmware over SPI after every reset. Stage the DFP with:
#   bash mmwave/setup-awr6243.sh --dfp ~/Downloads/mmwave_dfp_06_04_01_00.zip
AWR6243_DFP_ROOT="${HOME}/ti/mmwave_dfp"
AWR6243_FW_IMAGE=""                # e.g. $AWR6243_DFP_ROOT/firmware/<metaImage>.bin

# ─── Raw ADC capture path ────────────────────────────────────────────
# "csi2"  — 4 data + 1 clock MIPI D-PHY lanes into the host (production path)
# "dca1000" — LVDS debug port into a DCA1000EVM (bench only, debug interface)
AWR6243_CAPTURE="csi2"
AWR6243_CSI2_VIDEO_NODE="/dev/video0"
AWR6243_CSI2_LANES="4"
AWR6243_CSI2_RATE_MBPS="600"       # 150-600 Mbps per lane

# ─── Host-side radar application ─────────────────────────────────────
AWR6243_VENV="${HOME}/.venvs/radar"
AWR6243_APP_DIR="${HOME}/work/cubeship-mmwave-firmware/radar"
